{
  "name": "@rrss/desktop",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "bash ../../scripts/dev-desktop.sh",
    "dev:desktop:mcp": "bash ../../scripts/dev-desktop.sh --mcp",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 1420",
    "test": "vitest run",
    "test:e2e": "playwright test --reporter=line",
    "test:perf": "playwright test -c playwright.perf.config.ts --reporter=line",
    "test:perf:minimal": "PERF_SCENE=minimal playwright test -c playwright.perf.config.ts --reporter=line",
    "test:perf:daily": "PERF_SCENE=daily playwright test -c playwright.perf.config.ts --reporter=line",
    "test:perf:stress": "PERF_SCENE=stress playwright test -c playwright.perf.config.ts --reporter=line",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "check:hooks": "node tooling/check-hooks.mjs",
    "check:deps": "node tooling/check-deps.mjs",
    "check:ipc": "node tooling/check-ipc.mjs",
    "check:i18n": "node tooling/check-i18n.mjs",
    "check:frontend": "pnpm run check:types && pnpm run check:hooks && pnpm run check:deps && pnpm run check:ipc && pnpm run check:i18n",
    "check:frontend:report": "node tooling/check-hooks.mjs --report && node tooling/check-deps.mjs --report",
    "perf:report": "node tooling/perf-report.mjs",
    "test:tooling": "node --test tooling/*.test.mjs",
    "test:affected": "node tooling/affected.mjs",
    "tauri": "tauri --config ../../crates/rrss-desktop/tauri.conf.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "i18next": "^27.1.1",
    "lowlight": "^3.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^18.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
